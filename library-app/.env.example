# ──────────────────────────────────────────────────────────────────────────────
# Library App — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (used by Docker Compose and Prisma)
POSTGRES_USER=library
POSTGRES_PASSWORD=library
POSTGRES_DB=library_dev
DATABASE_URL=postgresql://library:library@localhost:5432/library_dev

# JWT secrets — use long random strings in production (>= 32 chars)
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-in-production-refresh-openssl-rand-hex-32

# Backend server
PORT=3000
NODE_ENV=development

# Frontend — URL of the backend API (seen from the browser)
VITE_API_URL=http://localhost:3000
