FROM node:20-alpine
WORKDIR /app

# Copy workspace manifests and prisma schema before npm install
# so that prisma generate (postinstall hook) has the schema available
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/
COPY backend/prisma/schema.prisma ./backend/prisma/
RUN npm install

# Source is mounted via docker-compose volume at runtime (hot-reload)
COPY . .

WORKDIR /app/backend
EXPOSE 3000
CMD ["sh", "docker-entrypoint.sh"]
